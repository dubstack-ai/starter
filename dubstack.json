{
  "$schema": "https://dubstack.dev/schema/v1.json",
  "site": {
    "name": "dubstack",
    "tagline": "Beautiful, AI-powered documentation for modern teams",
    "logo": {
      "light": "/logo/light.svg",
      "dark": "/logo/dark.svg"
    },
    "favicon": "/img/favicon.ico",
    "timezone": "UTC"
  },
  "topbarCtaButton": {
    "label": "Get Started",
    "href": "/quickstart"
  },
  "theme": {
    "colors": {
      "primary": "#ff6b35",
      "accent": "#14b8a6",
      "background": "#0e0e10",
      "sidebar_background": "#18171A",
      "content_background": "#0e0e10",
      "header_background": "#0e0e10",
      "footer_background": "#18171A",
      "text_primary": "#f3f4f6",
      "text_secondary": "#a1a1aa",
      "text_muted": "#71717a",
      "border_default": "#ffffff14",
      "border_subtle": "rgba(255, 255, 255, 0.06)"
    },
    "fonts": {
      "heading": "Inter",
      "body": "Inter",
      "code": "JetBrains Mono"
    },
    "code_block": {
      "background": "#0d0d0d",
      "header_background": "#18171A",
      "border_color": "#2d2d2d",
      "header_height": 32,
      "radius": 18,
      "syntax_theme": "github-dark"
    },
    "scrollbar": {
      "track_dark": "#1a1a1a",
      "thumb_dark": "#404040",
      "track_light": "#f0f0f0",
      "thumb_light": "#c0c0c0"
    }
  },
  "widgets": {
    "search": {
      "enabled": true,
      "placeholder": "Search...",
      "position": "sidebar"
    },
    "assistant": {
      "title": "Assistant",
      "welcome_title": "Hi! How can I help you today?",
      "welcome_subtitle": "Ask me anything about the docs, code samples, or best practices.",
      "logo_url": "/img/assistant-star.svg",
      "watermark_logo_url": "/img/dubstack-colour.svg",
      "background_color": "#0e0e10",
      "width": 300
    }
  },
  "layout": {
    "sidebar": {
      "width": 200,
      "position": "left",
      "collapsible": true
    },
    "header": {
      "height": 70,
      "sticky": true
    },
    "content": {
      "max_width": 900
    }
  },
  "canvas_layout": {
    "components": [
      {
        "instanceId": "default-header",
        "componentId": "site-header",
        "x": 0,
        "y": 0,
        "width": 1200,
        "height": 56,
        "zIndex": 2
      },
      {
        "instanceId": "default-sidebar",
        "componentId": "sidebar-nav",
        "x": 0,
        "y": 56,
        "width": 200,
        "height": 844,
        "zIndex": 1
      },
      {
        "instanceId": "default-assistant",
        "componentId": "assistant-widget",
        "x": 900,
        "y": 56,
        "width": 300,
        "height": 844,
        "zIndex": 10
      },
      {
        "instanceId": "main-content",
        "componentId": "main-content",
        "x": 224,
        "y": 56,
        "width": 600,
        "height": 844,
        "zIndex": 1,
        "locked": true
      }
    ],
    "last_updated": "2025-12-30T02:00:00.000Z"
  },
  "navigation": {
    "anchors": [
      {
        "name": "Documentation",
        "url": "https://docs.dubstack.ai",
        "icon": "book"
      },
      {
        "name": "Blog",
        "url": "https://blogs.dubstack.ai",
        "icon": "newspaper"
      }
    ],
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "default": true,
        "pages": ["index", "quickstart", "development"]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "pages": ["api-reference/introduction", "api-reference/endpoint/get", "api-reference/endpoint/create", "api-reference/endpoint/delete", "api-reference/endpoint/webhook"]
      }
    ],
    "header": [
      {
        "label": "Home",
        "href": "/"
      },
      {
        "label": "Docs",
        "href": "/docs"
      }
    ],
    "sidebar": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "pages": ["index", "quickstart", "development"]
      },
      {
        "group": "Essentials",
        "icon": "layers",
        "pages": ["essentials/markdown", "essentials/code", "essentials/images", "essentials/navigation", "essentials/reusable-snippets", "essentials/settings"]
      },
      {
        "group": "API Reference",
        "icon": "code",
        "pages": ["api-reference/introduction", "api-reference/endpoint/get", "api-reference/endpoint/create", "api-reference/endpoint/delete", "api-reference/endpoint/webhook"]
      },
      {
        "group": "AI Tools",
        "icon": "sparkles",
        "pages": ["ai-tools/claude-code", "ai-tools/cursor", "ai-tools/windsurf"]
      }
    ]
  },
  "homepage": {
    "type": "docs",
    "landing_page": null,
    "hero": {
      "title": "Welcome to dubstack",
      "tagline": "Beautiful, AI-powered documentation for modern teams",
      "cta": {
        "label": "Get Started",
        "href": "/quickstart"
      }
    }
  },
  "sections": {},
  "footer": {
    "socials": {},
    "links": []
  },
  "seo": {
    "title_template": "%s | dubstack",
    "description": "Beautiful, AI-powered documentation platform for modern teams. Create stunning docs with OpenAPI support, Theme Studio, and MCP server integration.",
    "og_image": "/images/hero-light.png"
  },
  "integrations": {
    "analytics": {
      "google": null,
      "plausible": null
    },
    "ai": {
      "provider": null,
      "api_key_env": "OPENAI_API_KEY"
    }
  },
  "auth": {
    "enabled": false,
    "provider": "oidc",
    "provider_name": "SSO",
    "provider_icon_url": "",
    "oidc": {
      "issuer": "",
      "client_id": "",
      "scopes": "openid profile email",
      "token_proxy": ""
    },
    "feature_tier": "free",
    "require_auth_for_admin": true,
    "require_auth_for_docs": false
  }
}
